# Backend API URL — change this to point at your deployed backend.
#
# This file is gitignored, so a checkout on another machine (or a CI/host build)
# will NOT have it and falls back to http://localhost:8000. Set
# VITE_API_BASE_URL in the host's environment settings when deploying the
# frontend, not here.
#
# Vite inlines this at BUILD time, not runtime — changing it means rebuilding.
# No trailing slash: axios joins paths onto it directly.
VITE_API_BASE_URL=https://main-project-t3wr.onrender.com

# Local backend, for switching back:
# VITE_API_BASE_URL=http://localhost:8000
